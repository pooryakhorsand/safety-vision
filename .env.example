# Copy this file to ".env" (same folder) and edit the values.
# The .env file is never committed to git.

# --- Django ---------------------------------------------------------------
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Must be 32+ random characters when DJANGO_DEBUG is False.
DJANGO_SECRET_KEY=change-me

# True only on your development machine. Always False on the operator's machine.
DJANGO_DEBUG=True

# Comma-separated host names the web app answers to.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Which customer profile to load from the profiles/ folder (branding, modules, language).
SITE_PROFILE=default

# --- Database -------------------------------------------------------------
# Empty  -> SQLite file (web/db.sqlite3 in development, <data folder>/db/ when installed).
# Production -> PostgreSQL, e.g.:
#   DATABASE_URL=postgres://app:<password>@127.0.0.1:5432/app
# (deploy/docker-compose.yml starts a matching PostgreSQL; it is optional.)
DATABASE_URL=

# --- Storage --------------------------------------------------------------
# Where snapshots, clips and backups are written. Empty -> <project>/data
DATA_DIR=
# Backup folder (use another disk if possible). Empty -> <DATA_DIR>/backups
BACKUP_DIR=
# How many daily backups to keep.
BACKUP_KEEP=14

# --- Engine ---------------------------------------------------------------
# Shared secret the engine sends with every event (Authorization: Bearer ...).
# Generate it the same way as the secret key. The engine's own config must use the same value.
# Must be 32+ random characters when DJANGO_DEBUG is False.
ENGINE_API_TOKEN=change-me-engine-token

# Where the operator's browser finds the engine's live pictures (engine setting render.stream_port).
ENGINE_STREAM_URL=http://127.0.0.1:8765
# Seconds without a heartbeat before the status bar shows "Engine offline".
ENGINE_HEARTBEAT_TIMEOUT_SECONDS=20
